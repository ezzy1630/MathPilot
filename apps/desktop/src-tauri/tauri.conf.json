{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathPilot",
  "version": "0.1.0",
  "identifier": "local.mathpilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MathPilot",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost http://asset.localhost tauri://localhost https://tauri.localhost http://tauri.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; frame-src https://www.desmos.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.geogebra.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": {
      "../../../scripts/math_check.py": "scripts/math_check.py",
      "../../../scripts/ocr_homework.py": "scripts/ocr_homework.py",
      "../../../skills/": "skills/",
      "resources/bin/mathpilot-ocr": "bin/mathpilot-ocr",
      "resources/python/": "python/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
