{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/contracts.ts",
    "src/checkAnswer.ts",
    "src/symbolicCheck.ts",
    "src/desktopAdapter.ts"
  ]
}
